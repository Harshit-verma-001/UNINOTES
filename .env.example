# Use a pooled PostgreSQL URL for the running app and a direct URL for schema updates.
DATABASE_URL="postgresql://USER:PASSWORD@POOL_HOST:5432/postgres?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@DB_HOST:5432/postgres?sslmode=verify-full"

# Generate an independent secret for each deployment.
JWT_SECRET=""

NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
